{
  "pawl-send-gates": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only send --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-destructive-git-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only git --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-poll-loop-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only poll --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-oscillation-breaker": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only loop --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -B hooks/pawl.py stop --only loop --harness antigravity",
        "timeout": 15
      }
    ]
  },
  "pawl-noop-edit-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only noop --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-zero-width-sanitizer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only zero-width --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-conversation-fence": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only fence --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-reread-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "view_file|run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only reread --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 -B hooks/pawl.py stop --only reread --harness antigravity",
        "timeout": 15
      }
    ]
  },
  "pawl-readonly-pass": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|run_shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B hooks/pawl.py pre --only readonly --harness antigravity",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "pawl-idle-task-gate": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python3 -B hooks/pawl.py stop --only idle --harness antigravity",
        "timeout": 15
      }
    ]
  }
}
