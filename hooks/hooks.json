{
  "description": "pawl gates for Claude Code: one dispatcher per event; see hooks/pawl.py",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/pawl.py\" pre --harness claude",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -B \"${CLAUDE_PLUGIN_ROOT}/hooks/pawl.py\" stop --harness claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
